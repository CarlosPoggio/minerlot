# Copy this file to .env in the same folder and fill in real values.
# .env itself is gitignored — never commit real secrets here.

# Bitcoin Core RPC credentials, shared between bitcoind and public-pool.
# Only reachable inside the internal Docker network, never published.
RPC_USER=minerlot
RPC_PASSWORD=change-me-to-a-long-random-value

# The Bitcoin address the monitoring dashboard displays and queries stats
# for. This is NOT how payouts are configured — each Bitaxe supplies its
# own payout address as its stratum username (see docs/CONECTAR_MINERO.md).
# This is just which address's workers to show on the dashboard.
WALLET_ADDRESS=bc1q...
